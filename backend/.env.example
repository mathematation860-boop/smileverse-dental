# Copy this file to .env and fill in real values. NEVER commit the real
# .env file — it's already in .gitignore.

# --- Currently required (the app runs today with just these) ---
PORT=5000
GEMINI_API_KEY=
MONGODB_URI=
# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app,https://staging-your-app.vercel.app
# A bare * keeps the demo working out of the box but should be tightened
# before handling real patient data. Note (Phase 3): the admin session
# cookie requires CORS to run with credentials:true, which the server
# already does — a bare * still works because the server reflects the
# request's actual Origin header in that case (see server.js), but for
# real patient data set this to your real frontend URL(s) explicitly.
CORS_ORIGIN=*
# Which practice (see backend/config/practices/) serves requests that
# don't send an X-Practice-Id header. Only relevant once a second
# practice exists.
DEFAULT_PRACTICE_ID=smileverse-dental

# --- Phase 3: Admin authentication + clinic dashboard ---
# Signs/verifies the admin session cookie (services/auth/sessionTokens.js).
# Required — admin login refuses to run at all without it. Generate a long
# random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER reuse this value across environments/practices, and never commit it.
ADMIN_JWT_SECRET=
# Create the first admin account for a practice (there is no public sign-up
# endpoint by design — see backend/scripts/createAdmin.js):
#   node scripts/createAdmin.js --practiceId=smileverse-dental \
#     --name="Dr. Ayesha Khan" --email=admin@smileverse.com --password=... \
#     --role=practice_admin
# Set NODE_ENV=production on real deployments (Railway sets this
# automatically) — it makes the admin session cookie `secure` (HTTPS-only).

# --- Phase 2: Google Calendar (only required once a practice is switched
# out of demo mode by setting demoMode:false AND
# integrations.calendarProvider:'google' in its config file — see
# services/providers/GoogleCalendarAppointmentProvider.js) ---
# From a Google Cloud project's OAuth 2.0 Client ID (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
# Phase 3 update: normal calendar connect/disconnect now goes through the
# admin dashboard (session-authenticated — see routes/adminCalendarAuth.js),
# NOT this shared secret. CALENDAR_ADMIN_SECRET only still gates the
# original /api/calendar/oauth/start|disconnect routes, kept as a
# non-interactive/ops fallback (e.g. before any admin account exists yet).
# Leave unset once every practice has an admin account — the dashboard
# doesn't need it. If you do set it, generate a long random value and keep
# it secret; those legacy endpoints refuse to run at all if it's unset.
CALENDAR_ADMIN_SECRET=
# Where to send the browser after a Google Calendar connect attempt
# succeeds/fails (your deployed frontend URL). Optional — without it, the
# callback just returns a plain text/JSON result instead of redirecting.
FRONTEND_URL=

# --- Phase 4: Voice AI receptionist (only takes effect once a practice is
# switched out of demo mode by setting demoMode:false AND
# integrations.voiceProvider:'twilio' in its config file — see
# services/voice/index.js and config/practices/smileverse-dental.js. Until
# then, every call this app answers runs on the mock telephony provider —
# no real phone number, no real Twilio account required to try it.) ---
# From the Twilio Console (Account Info) — required for real calls, and
# required for real webhook signature verification (services/voice/
# TwilioTelephonyProvider.js). NEVER commit these; treat like a password.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number this practice's calls arrive on, in E.164 format
# (e.g. +15551234567). This is what config/practiceRepository.js's
# getPracticeIdForPhoneNumber() matches against — a phone call's "To"
# number is the ONLY thing that resolves which practice it belongs to
# (never anything the caller says or sends). Point that Twilio number's
# "A call comes in" webhook (Voice Configuration in the Twilio Console) at:
#   https://<your-railway-app>.up.railway.app/api/voice/incoming
# and its optional status callback at:
#   https://<your-railway-app>.up.railway.app/api/voice/status
# Both must be reachable over HTTPS in production — Twilio's signature
# verification will fail over plain HTTP.
SMILEVERSE_VOICE_PHONE_NUMBER=

# --- Phase 5: SMS + Email notifications (only takes effect once a practice
# is switched out of demo mode by setting demoMode:false AND
# integrations.smsProvider:'twilio' / integrations.emailProvider:'sendgrid'
# in its config file — see services/notifications/index.js and
# config/practices/smileverse-dental.js. Until then, every notification
# this app "sends" is simulated by the mock providers — no real SMS/email
# is delivered, and the admin Notifications page/history clearly label
# these as "Simulated", never "Sent".) ---
# Reuses the SAME Twilio account as Phase 4 voice (TWILIO_ACCOUNT_SID/
# TWILIO_AUTH_TOKEN above) — Twilio Programmable SMS is billed/managed
# under the same account. This is the FROM number texts are sent from; it
# can be the same Twilio number as SMILEVERSE_VOICE_PHONE_NUMBER (one
# number can both receive calls and texts) or a different one.
TWILIO_SMS_FROM_NUMBER=
# Optional — when set, Twilio POSTs a real delivery-status update to this
# URL after every outbound SMS this app sends, updating the matching
# notification history record from "accepted" to "delivered"/"failed"/etc.
# Without it, notification history still honestly reflects whatever
# Twilio's synchronous response said (e.g. "queued") — never a fabricated
# "delivered". Typically:
#   https://<your-railway-app>.up.railway.app/api/sms/status
TWILIO_SMS_STATUS_CALLBACK_URL=
# The number patients text INTO — resolves which practice an inbound SMS
# belongs to (config/practiceRepository.js's getPracticeIdForPhoneNumber),
# the same way SMILEVERSE_VOICE_PHONE_NUMBER does for calls. Point that
# Twilio number's "A message comes in" webhook (Messaging Configuration in
# the Twilio Console) at:
#   https://<your-railway-app>.up.railway.app/api/sms/incoming
# and its delivery status callback at:
#   https://<your-railway-app>.up.railway.app/api/sms/status
SMILEVERSE_SMS_PHONE_NUMBER=
# From SendGrid (Settings -> API Keys), required for real email — see
# services/notifications/SendGridEmailProvider.js. This project calls
# SendGrid's REST API directly via Node's built-in fetch, so no SDK/new
# npm dependency is required to go live with email.
SENDGRID_API_KEY=
# Must be a sender identity SendGrid has verified for this account (Single
# Sender Verification, or a verified domain) — SendGrid rejects sends from
# an unverified From address.
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# --- Phase 6: Open Dental PMS integration (only takes effect once a
# practice is switched out of demo mode by setting demoMode:false AND
# integrations.pmsProvider:'openDental' in its config file — see
# services/pms/index.js and config/practices/smileverse-dental.js. Until
# then, every PMS operation this app performs runs on MockPMSProvider —
# no real Open Dental account, no real patient/appointment data.) ---
# From Open Dental's Developer Portal (contact vendor.relations@opendental.com
# to become a registered developer — see services/pms/OpenDentalPMSProvider.js's
# header comment for the exact process and required information).
OPENDENTAL_DEVELOPER_KEY=
# Generated by the developer in the Developer Portal, then added by the
# CUSTOMER (the dental office) in their own Open Dental software under
# Setup > Advanced Setup > API > Add Key. One customer key per office.
OPENDENTAL_CUSTOMER_KEY=
# Optional overrides — default to Open Dental's own hosted API and no
# specific clinic filter, which is correct for a single-location office:
# OPENDENTAL_API_BASE_URL=https://api.opendental.com/api/v1
# OPENDENTAL_CLINIC_NUM=

# --- Not required yet — placeholders for future integrations ---
# A production database migration away from MongoDB (see docs/DATA_MODEL.md):
# DATABASE_URL=
