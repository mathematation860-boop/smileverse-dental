# Copy this file to .env and fill in real values. NEVER commit the real
# .env file — it's already in .gitignore.

# --- Currently required (the app runs today with just these) ---
PORT=5000
GEMINI_API_KEY=
MONGODB_URI=
# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app,https://staging-your-app.vercel.app
# A bare * keeps the demo working out of the box but should be tightened
# before handling real patient data.
CORS_ORIGIN=*
# Which practice (see backend/config/practices/) serves requests that
# don't send an X-Practice-Id header. Only relevant once a second
# practice exists.
DEFAULT_PRACTICE_ID=smileverse-dental

# --- Phase 2: Google Calendar (only required once a practice is switched
# out of demo mode by setting demoMode:false AND
# integrations.calendarProvider:'google' in its config file — see
# services/providers/GoogleCalendarAppointmentProvider.js) ---
# From a Google Cloud project's OAuth 2.0 Client ID (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
# This app has no admin login system yet, so this shared secret is what
# gates who can start/stop a calendar connection (GET /api/calendar/oauth/start,
# POST /api/calendar/disconnect) — generate a long random value and keep it
# secret. Required; the endpoints refuse to run at all if this is unset.
CALENDAR_ADMIN_SECRET=
# Where to send the browser after a Google Calendar connect attempt
# succeeds/fails (your deployed frontend URL). Optional — without it, the
# callback just returns a plain text/JSON result instead of redirecting.
FRONTEND_URL=

# --- Not required yet — placeholders for future integrations ---
# A real dental PMS integration would need credentials here, named per
# provider once one is actually chosen (see services/providers/PMSProvider.js):
# PMS_API_KEY=

# Real email/SMS providers (see services/notifications/):
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# A production database migration away from MongoDB (see docs/DATA_MODEL.md):
# DATABASE_URL=

# If/when the app needs its own signed sessions or admin auth:
# SESSION_SECRET=
# APP_URL=https://your-deployed-frontend.example.com
