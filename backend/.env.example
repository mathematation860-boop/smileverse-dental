# Copy this file to .env and fill in real values. NEVER commit the real
# .env file — it's already in .gitignore.

# --- Currently required (the app runs today with just these) ---
PORT=5000
GEMINI_API_KEY=
MONGODB_URI=
# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app,https://staging-your-app.vercel.app
# A bare * keeps the demo working out of the box but should be tightened
# before handling real patient data. Note (Phase 3): the admin session
# cookie requires CORS to run with credentials:true, which the server
# already does — a bare * still works because the server reflects the
# request's actual Origin header in that case (see server.js), but for
# real patient data set this to your real frontend URL(s) explicitly.
CORS_ORIGIN=*
# Which practice (see backend/config/practices/) serves requests that
# don't send an X-Practice-Id header. Only relevant once a second
# practice exists.
DEFAULT_PRACTICE_ID=smileverse-dental

# --- Phase 3: Admin authentication + clinic dashboard ---
# Signs/verifies the admin session cookie (services/auth/sessionTokens.js).
# Required — admin login refuses to run at all without it. Generate a long
# random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER reuse this value across environments/practices, and never commit it.
ADMIN_JWT_SECRET=
# Create the first admin account for a practice (there is no public sign-up
# endpoint by design — see backend/scripts/createAdmin.js):
#   node scripts/createAdmin.js --practiceId=smileverse-dental \
#     --name="Dr. Ayesha Khan" --email=admin@smileverse.com --password=... \
#     --role=practice_admin
# Set NODE_ENV=production on real deployments (Railway sets this
# automatically) — it makes the admin session cookie `secure` (HTTPS-only).

# --- Phase 2: Google Calendar (only required once a practice is switched
# out of demo mode by setting demoMode:false AND
# integrations.calendarProvider:'google' in its config file — see
# services/providers/GoogleCalendarAppointmentProvider.js) ---
# From a Google Cloud project's OAuth 2.0 Client ID (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
# Phase 3 update: normal calendar connect/disconnect now goes through the
# admin dashboard (session-authenticated — see routes/adminCalendarAuth.js),
# NOT this shared secret. CALENDAR_ADMIN_SECRET only still gates the
# original /api/calendar/oauth/start|disconnect routes, kept as a
# non-interactive/ops fallback (e.g. before any admin account exists yet).
# Leave unset once every practice has an admin account — the dashboard
# doesn't need it. If you do set it, generate a long random value and keep
# it secret; those legacy endpoints refuse to run at all if it's unset.
CALENDAR_ADMIN_SECRET=
# Where to send the browser after a Google Calendar connect attempt
# succeeds/fails (your deployed frontend URL). Optional — without it, the
# callback just returns a plain text/JSON result instead of redirecting.
FRONTEND_URL=

# --- Not required yet — placeholders for future integrations ---
# A real dental PMS integration would need credentials here, named per
# provider once one is actually chosen (see services/providers/PMSProvider.js):
# PMS_API_KEY=

# Real email/SMS providers (see services/notifications/):
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# A production database migration away from MongoDB (see docs/DATA_MODEL.md):
# DATABASE_URL=
