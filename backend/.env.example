# Copy this file to .env and fill in real values. NEVER commit the real
# .env file — it's already in .gitignore.

# --- Currently required (the app runs today with just these) ---
PORT=5000
GEMINI_API_KEY=
MONGODB_URI=
# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app,https://staging-your-app.vercel.app
# A bare * keeps the demo working out of the box but should be tightened
# before handling real patient data.
CORS_ORIGIN=*
# Which practice (see backend/config/practices/) serves requests that
# don't send an X-Practice-Id header. Only relevant once a second
# practice exists.
DEFAULT_PRACTICE_ID=smileverse-dental

# --- Not required yet — placeholders for future integrations ---
# A real calendar/PMS integration would need credentials here, named per
# provider once one is actually chosen (see services/providers/PMSProvider.js
# and services/providers/AppointmentProvider.js):
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# PMS_API_KEY=

# Real email/SMS providers (see services/notifications/):
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# A production database migration away from MongoDB (see docs/DATA_MODEL.md):
# DATABASE_URL=

# If/when the app needs its own signed sessions or admin auth:
# SESSION_SECRET=
# APP_URL=https://your-deployed-frontend.example.com
